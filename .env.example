PUMPGUARD_HISTORY_LIMIT=1000
PUMPGUARD_LOG_LEVEL=INFO
PUMPGUARD_DIAGNOSTIC_PROVIDER=amd
PUMPGUARD_DIAGNOSTIC_TIMEOUT_SECONDS=250
PUMPGUARD_DIAGNOSTIC_CONNECT_TIMEOUT_SECONDS=3
PUMPGUARD_DIAGNOSTIC_CATALOG_TIMEOUT_SECONDS=5
PUMPGUARD_DIAGNOSTIC_COMPLETION_TIMEOUT_SECONDS=240
PUMPGUARD_DIAGNOSTIC_MAX_OUTPUT_TOKENS=1800
RADEON_API_KEY=PASTE_YOUR_AMD_API_KEY_HERE
RADEON_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
RADEON_MODEL=DeepSeek-V4-Flash

# Explicit browser origins. Use the deployed frontend origin(s), comma-separated.
PUMPGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Process-local demo limits. These protect one API process and are not global limits.
PUMPGUARD_RATE_LIMIT_WINDOW_SECONDS=60
PUMPGUARD_RATE_LIMIT_SIMULATION=120
PUMPGUARD_RATE_LIMIT_ANALYSIS=60
PUMPGUARD_RATE_LIMIT_ML=30
